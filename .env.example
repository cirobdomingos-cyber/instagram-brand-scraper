# Apify token — get one at https://console.apify.com/settings/integrations
APIFY_API_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxx

# Google OAuth client ID. If unset, app runs in MOCK mode (X-Mock-Email
# header trusted iff allowlisted). Real prod deploy MUST set this.
# Create at https://console.cloud.google.com/apis/credentials → OAuth 2.0
# Authorized origins: your Railway URL (https://your-app.up.railway.app)
GOOGLE_CLIENT_ID=

# Comma-separated email allowlist. The OWNER_EMAIL is auto-included.
# Anyone NOT on this list will hit a 403 on every API call.
ALLOWED_EMAILS=friend1@example.com,friend2@example.com

# Owner email — auto-added to the allowlist regardless of ALLOWED_EMAILS.
OWNER_EMAIL=ciro.b.domingos@gmail.com

# Where scraped data lives. /data on Railway when a volume is mounted there.
DATA_ROOT=./data

# Cap on posts fetched per scrape (Apify cost control).
MAX_POSTS_PER_SCRAPE=50
